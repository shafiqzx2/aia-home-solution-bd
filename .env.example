# For a new checkout only. Never overwrite existing local credentials.
NEXT_TELEMETRY_DISABLED=1

POSTGRES_DB=aia
POSTGRES_USER=aia_app
# Intentionally empty: Compose requires a nonempty value supplied locally.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set the matching URL locally; URL-encode its password component.
# Format: postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/DATABASE?schema=public
DATABASE_URL=
DIRECT_URL=

# Server-only. Configure privately; never use NEXT_PUBLIC for these values.
AIA_BUSINESS_ENABLED=false
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
AIA_MFA_ENABLED=false
# Set only after the actual production target and owner MFA are verified.
AIA_PRODUCTION_AUTH_VERIFIED=false
# Leave unset unless a trusted reverse proxy overwrites this header reliably.
AIA_TRUSTED_IP_HEADER=

# Private S3-compatible bucket. Credentials only read/write images/*, documents/*
# and resumes/*; no public bucket policy or delete permission. Verify privately.
AIA_STORAGE_DRIVER=s3
AIA_STORAGE_PRIVATE_VERIFIED=false
AIA_S3_BUCKET=
AIA_S3_ENDPOINT=
AIA_S3_REGION=auto
AIA_S3_PATH_STYLE=false
AIA_S3_ACCESS_KEY_ID=
AIA_S3_SECRET_ACCESS_KEY=
# Remote Chromium CDP endpoint for serverless PDF archival. Use wss:// privately.
AIA_PDF_BROWSER_WS=
# Local-only alternative: AIA_STORAGE_DRIVER=local, optional browser executable.
AIA_PDF_EXECUTABLE=

# Email queue stays paused until provider, verified sender/domain and worker are approved.
AIA_EMAIL_PROVIDER=resend
AIA_EMAIL_SENDING_ENABLED=false
AIA_EMAIL_PROVIDER_VERIFIED=false
AIA_EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Random server-only secret, at least 32 characters; scheduler POSTs to /api/internal/email-worker.
AIA_EMAIL_WORKER_SECRET=
# Private storage credentials also need GetObject/PutObject for resumes/*.
# PDF resumes remain QUARANTINED until a separate verified scanning workflow exists.
