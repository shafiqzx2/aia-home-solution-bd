.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
.npmrc*
.pgpass
pgpass.conf
.pg_service.conf
.aws/
.ssh/
.secrets/
secrets/

# Local provider credentials and exports (never stage these files)
cf-r2-cred.txt
*-cred.txt
*-creds.txt
*credential*.txt
*credential*.json
*credential*.csv
*credential*.yaml
*credential*.yml
*secret*.txt
*secret*.json
*secret*.csv
*secret*.yaml
*secret*.yml
service-account*.json
*-service-account*.json
credentials/
credential-exports/
token-exports/
.git-credentials
.netrc
_netrc
id_rsa*
id_ed25519*

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.env
*.env.*
!/.env.example

# Local database data/backups (Compose uses a named volume, not a bind mount)
postgres-data/
db-data/
backups/
*.sql
*.sql.*
*.dump
*.dump.*
*.backup
*.bak
*.tar
*.tar.gz
*.tgz
!/prisma/migrations/**/migration.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
